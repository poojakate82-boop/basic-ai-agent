@startuml
title SLE-3 Level 3 - Component Diagram\nBinary Search Engine

skinparam shadowing false
skinparam roundcorner 15
skinparam defaultFontName Arial

rectangle "BINARY SEARCH ENGINE" {

    rectangle "Initialize Low & High" as Init

    rectangle "Calculate Mid" as Mid

    rectangle "Compare Target\nwith Middle Element" as Compare

    rectangle "Update Search Range" as Update

    rectangle "Return Search Result" as Result
}

Init --> Mid : Search range
Mid --> Compare : Middle element

Compare --> Result : Target found
Compare --> Update : Target not found

Update --> Mid : New range

@enduml